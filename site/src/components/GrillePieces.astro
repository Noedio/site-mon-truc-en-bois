---
// Grille à filets (brief §3) : chaque carte trace ses filets droit et bas, la grille trace le haut et la gauche.
// Une dernière rangée incomplète reste ainsi couleur bouleau, sans case vide foncée.
// Chaque carte porte son bouton cœur (CarteFavori) : on garde une pièce sans ouvrir sa fiche.
// data-prix et data-numero servent au tri de la boutique (FiltresBoutique).
import CarteFavori from "./CarteFavori.astro";
import { prixDe, type Produit } from "../lib/donnees";

interface Props { produits: (Produit & { numero: number })[]; prioritaires?: number; colonnes?: string }
const { produits, prioritaires = 0, colonnes = "minmax(min(240px, 100%), 1fr)" } = Astro.props;
---
<div class="grille-pieces" style={`--colonnes: ${colonnes}`} data-grille-pieces>
  {produits.map((p, i) => <CarteFavori produit={p} prioritaire={i < prioritaires} data-prix={prixDe(p).prix} data-numero={p.numero} />)}
</div>

<style>
  .grille-pieces {
    display: grid;
    grid-template-columns: repeat(auto-fill, var(--colonnes));
    border-top: var(--filet);
    border-left: var(--filet);
  }
  .grille-pieces > :global(*) { box-shadow: 1px 0 0 var(--brule), 0 1px 0 var(--brule); }
  @media (max-width: 520px) {
    .grille-pieces { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>
