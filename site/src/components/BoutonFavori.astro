---
// Bouton cœur pour mettre une pièce de côté (favoris gardés dans ce navigateur, clé favoris-mtb).
// 44 px, aria-pressed. À poser sur la fiche produit (C3) ou sur une carte (CarteFavori).
// Plusieurs boutons de la même pièce sur une page restent synchronisés.
interface Props { id: string; nom: string; class?: string }
const { id, nom, class: classe } = Astro.props;
---
<button type="button" class:list={["bouton-favori", classe]} data-favori={id} aria-pressed="false" aria-label={`Garder ${nom} dans mes favoris`}>
  <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false">
    <path d="M12 20.5 3.9 12.6a5 5 0 0 1 0-7.1 5 5 0 0 1 7.1 0l1 1 1-1a5 5 0 0 1 7.1 7.1Z" />
  </svg>
</button>

<script>
  import { basculerFavori, lireFavoris } from "../lib/panier";

  const synchroniser = () => {
    const favoris = lireFavoris();
    document.querySelectorAll<HTMLButtonElement>("[data-favori]").forEach((b) => {
      b.setAttribute("aria-pressed", String(favoris.includes(b.dataset.favori!)));
    });
  };

  document.addEventListener("click", (e) => {
    const bouton = (e.target as Element).closest<HTMLButtonElement>("[data-favori]");
    if (!bouton) return;
    basculerFavori(bouton.dataset.favori!);
    const garde = lireFavoris().includes(bouton.dataset.favori!);
    let annonce = document.getElementById("annonce-favori");
    if (!annonce) {
      annonce = document.createElement("p");
      annonce.id = "annonce-favori";
      annonce.className = "annonce-favori etiquette";
      annonce.setAttribute("role", "status");
      document.body.append(annonce);
    }
    annonce.innerHTML = garde ? 'Gardé dans vos favoris. <a href="/favoris/">Voir mes favoris</a>' : "Retiré de vos favoris.";
    annonce.hidden = false;
    clearTimeout(Number(annonce.dataset.minuteur));
    annonce.dataset.minuteur = String(setTimeout(() => (annonce!.hidden = true), 5000));
  });
  document.addEventListener("favoris:change", synchroniser);
  window.addEventListener("storage", synchroniser);
  synchroniser();
</script>

<style is:global>
  .annonce-favori { position: fixed; left: 50%; bottom: calc(24px + env(safe-area-inset-bottom, 0px)); transform: translateX(-50%); z-index: 60; margin: 0; background: var(--brule); color: var(--bouleau); padding: 12px 16px; max-width: calc(100vw - 32px); }
  .annonce-favori a { color: var(--bouleau); font-weight: 700; }
</style>

<style>
  .bouton-favori {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--cible);
    height: var(--cible);
    padding: 0;
    border: var(--filet);
    border-radius: var(--rayon);
    background: var(--bouleau);
    color: var(--brule);
    cursor: pointer;
  }
  .bouton-favori:hover { background: var(--bouleau-fonce); }
  .bouton-favori path { fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linejoin: round; }
  .bouton-favori[aria-pressed="true"] path { fill: currentColor; }
</style>
