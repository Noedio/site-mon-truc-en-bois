---
// Frise des étapes d'une commande (src/lib/etapes.ts). Sans commande, elle explique le parcours ;
// avec une commande, le script de la page suivi marque chaque étape faite, en cours ou à venir.
import { ETAPES } from "../../lib/etapes";

interface Props { id?: string; libelle: string }
const { id, libelle } = Astro.props;
---
<ol class="frise" id={id} aria-label={libelle} data-frise>
  {ETAPES.map((e, i) => (
    <li class="frise-etape" data-etape={e.cle} data-etat="a-venir">
      <span class="frise-repere" aria-hidden="true"></span>
      <span class="frise-num etiquette">{String(i + 1).padStart(2, "0")}</span>
      <span class="frise-titre" data-titre-etape>{e.titre}</span>
      <span class="visuellement-cache" data-etat-lu></span>
      <span class="frise-texte">{e.texte}</span>
      <span class="frise-date etiquette" data-date-etape></span>
    </li>
  ))}
</ol>

<style>
  .frise { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); border-top: var(--filet); }
  .frise-etape { position: relative; display: flex; flex-direction: column; gap: 4px; padding: 22px 16px 18px 0; min-width: 0; }
  .frise-repere { position: absolute; top: -8px; left: 0; width: 15px; height: 15px; border: var(--filet); background: var(--bouleau); }
  .frise-num { color: var(--texte-doux); }
  .frise-titre { font-weight: 600; line-height: 1.3; }
  .frise-texte { font-size: 0.9375rem; color: var(--texte-doux); }
  .frise-date:empty { display: none; }

  .frise-etape[data-etat="faite"] .frise-repere { background: var(--brule); }
  .frise-etape[data-etat="en-cours"] .frise-repere { width: 17px; height: 17px; top: -9px; border: 5px solid var(--brule); }
  .frise-etape[data-etat="en-cours"] .frise-titre { font-family: var(--f-titre); font-weight: 800; font-size: 1.5rem; line-height: 1; text-transform: uppercase; }
  .frise-etape[data-etat="en-cours"] .frise-texte { color: var(--brule); }
  .frise[data-suivi] .frise-etape[data-etat="a-venir"] .frise-titre { color: var(--texte-doux); font-weight: 400; }

  @media (max-width: 860px) {
    .frise { grid-template-columns: minmax(0, 1fr); border-top: 0; border-left: var(--filet); margin-left: 8px; }
    .frise-etape { padding: 0 0 22px 26px; }
    .frise-etape:last-child { padding-bottom: 0; }
    .frise-repere { top: 3px; left: -8px; }
    .frise-etape[data-etat="en-cours"] .frise-repere { top: 2px; left: -9px; }
  }
</style>
