---
// Modèles d'une ligne du panier, remplis par le script de la page à partir de lirePanier().
// Rendus ici pour que les styles du composant s'appliquent aux copies faites dans le navigateur ;
// les photos (vignette du produit, photo du client) sont ajoutées par le script.
import { POLICES } from "../../lib/polices";
---
<template id="modele-ligne">
  <li class="ligne">
    <a class="ligne-vignette" data-lien tabindex="-1" aria-hidden="true">
      <span class="ligne-sans-photo etiquette" data-sans-vignette hidden>Photo à venir</span>
    </a>

    <div class="ligne-corps">
      <p class="etiquette doux" data-numero></p>
      <h3 class="ligne-nom"><a data-lien data-nom></a></h3>
      <p class="ligne-detail" data-variante hidden></p>

      <div class="ligne-gravure" data-gravure hidden>
        <p class="etiquette">Texte à graver · <span data-police-nom></span></p>
        <p class="ligne-texte" data-texte></p>
        <p class="ligne-detail" data-sans-texte hidden>Pas encore de texte.</p>
      </div>

      <div class="ligne-photo" data-photo-bloc hidden>
        <span class="ligne-photo-cadre" data-photo></span>
        <p class="ligne-detail">Votre photo : <span data-photo-nom></span></p>
      </div>

      <p class="ligne-detail" data-remarque hidden></p>
      <p class="ligne-alerte" data-alerte hidden></p>

      <button type="button" class="lien-action" data-modifier hidden>Modifier le texte ou la police</button>

      <div class="ligne-edition" data-edition hidden>
        <label class="etiquette" data-libelle-texte>Texte à graver</label>
        <textarea data-champ-texte rows="2" maxlength="200"></textarea>
        <p class="etiquette doux" data-compteur aria-live="polite"></p>
        <fieldset class="ligne-polices">
          <legend class="etiquette">Police</legend>
          {POLICES.map((p) => (
            <label class="police-choix">
              <input type="radio" value={p.nom} data-police />
              <span style={`font-family: ${p.famille}; font-weight: ${p.graisse}; ${p.capitales ? "text-transform: uppercase;" : ""}`}>{p.nom}</span>
            </label>
          ))}
          <label class="police-choix" data-police-ancienne hidden>
            <input type="radio" data-police />
            <span></span>
          </label>
        </fieldset>
        <div class="rangee ligne-edition-actions">
          <button type="button" class="bouton-ligne bouton-ligne-plein" data-enregistrer>Enregistrer</button>
          <button type="button" class="bouton-ligne" data-fermer>Annuler</button>
        </div>
      </div>
    </div>

    <div class="ligne-actions">
      <div class="quantite" role="group" data-groupe-quantite>
        <button type="button" data-moins>−</button>
        <input type="number" inputmode="numeric" min="1" max="99" data-quantite />
        <button type="button" data-plus>+</button>
      </div>
      <p class="ligne-prix">
        <span class="prix" data-total></span>
        <span class="etiquette doux" data-unitaire hidden></span>
      </p>
      <button type="button" class="lien-action" data-retirer>Retirer</button>
    </div>
  </li>
</template>

<template id="modele-ligne-retiree">
  <li class="ligne-retiree">
    <p><span data-nom-retire></span> est retirée du panier.</p>
    <button type="button" class="bouton-ligne" data-annuler>Annuler</button>
  </li>
</template>

<style>
  .ligne {
    display: grid;
    grid-template-columns: 120px minmax(0, 1fr) auto;
    gap: 16px 24px;
    padding: 20px 0;
    border-bottom: var(--filet);
  }
  .ligne-vignette { display: block; width: 120px; aspect-ratio: 1 / 1; background: var(--bouleau-fonce); border: var(--filet); }
  .ligne-vignette :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .ligne-sans-photo { display: flex; height: 100%; align-items: center; justify-content: center; padding: 8px; text-align: center; color: var(--texte-doux); }

  .ligne-corps { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
  .ligne-nom { font-family: var(--f-texte); font-weight: 600; font-size: 1.1875rem; line-height: 1.3; text-transform: none; letter-spacing: 0; }
  .ligne-nom a { display: inline-flex; align-items: center; min-height: var(--cible); text-decoration: none; }
  .ligne-nom a:hover { text-decoration: underline; }
  .ligne-detail { font-size: 0.9375rem; overflow-wrap: anywhere; }

  .ligne-gravure { margin-top: 4px; padding: 10px 14px 12px; background: var(--kraft); max-width: 34rem; }
  .ligne-texte { font-size: 1.5rem; line-height: 1.2; overflow-wrap: anywhere; white-space: pre-line; }

  .ligne-photo { display: flex; align-items: center; gap: 12px; }
  .ligne-photo-cadre { flex: none; width: 56px; height: 56px; border: var(--filet); background: var(--bouleau-fonce); }
  .ligne-photo-cadre :global(img) { width: 100%; height: 100%; object-fit: cover; }

  .ligne-alerte { color: var(--gravure); font-weight: 600; font-size: 0.9375rem; }

  .lien-action {
    align-self: flex-start;
    min-height: var(--cible);
    padding: 0;
    background: none;
    border: 0;
    font-family: var(--f-machine);
    font-size: var(--t-machine);
    text-align: left;
    text-decoration: underline;
    text-underline-offset: 0.2em;
    cursor: pointer;
  }
  .lien-action:hover { color: var(--gravure); }

  .ligne-edition { display: flex; flex-direction: column; gap: 8px; padding: 14px 0 4px; max-width: 34rem; }
  .ligne-edition textarea { resize: vertical; min-height: 72px; }
  .ligne-polices { margin: 6px 0 0; padding: 0; border: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(150px, 100%), 1fr)); gap: 8px; }
  .ligne-polices legend { padding: 0; margin-bottom: 6px; }
  .police-choix { position: relative; display: flex; align-items: center; min-height: 52px; padding: 6px 12px; border: var(--filet); background: var(--papier); cursor: pointer; font-size: 1.25rem; line-height: 1.1; }
  .police-choix input { position: absolute; opacity: 0; width: 1px; height: 1px; min-height: 0; }
  .police-choix:has(input:checked) { background: var(--brule); color: var(--bouleau); }
  .police-choix:has(input:focus-visible) { outline: 2px solid var(--gravure); outline-offset: 2px; }

  .bouton-ligne {
    min-height: var(--cible);
    padding: 8px 16px;
    border: var(--filet);
    background: transparent;
    font-family: var(--f-machine);
    font-size: var(--t-machine);
    font-weight: 700;
    cursor: pointer;
  }
  .bouton-ligne:hover { background: var(--brule); color: var(--bouleau); }
  .bouton-ligne-plein { background: var(--brule); color: var(--bouleau); }
  .bouton-ligne-plein:hover { background: var(--ardoise); }

  .ligne-actions { display: flex; flex-direction: column; align-items: flex-end; gap: 8px; }
  .quantite { display: flex; border: var(--filet); background: var(--papier); }
  .quantite button { width: var(--cible); height: var(--cible); border: 0; background: transparent; font-family: var(--f-machine); font-size: 1.25rem; cursor: pointer; }
  .quantite button:hover:not(:disabled) { background: var(--brule); color: var(--bouleau); }
  .quantite button:disabled { color: var(--texte-doux); cursor: not-allowed; }
  .quantite input {
    width: 52px;
    min-height: var(--cible);
    padding: 0;
    border: 0;
    border-inline: var(--filet);
    text-align: center;
    font-family: var(--f-machine);
    font-size: 1.0625rem;
    -moz-appearance: textfield;
    appearance: textfield;
  }
  .quantite input::-webkit-inner-spin-button,
  .quantite input::-webkit-outer-spin-button { -webkit-appearance: none; margin: 0; }
  .ligne-prix { display: flex; flex-direction: column; align-items: flex-end; text-align: right; }
  .ligne-prix .prix { color: var(--gravure); }

  .ligne-retiree {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 16px;
    padding: 14px 16px;
    margin: 12px 0;
    border: 1px dashed var(--brule);
  }

  @media (max-width: 640px) {
    .ligne { grid-template-columns: 84px minmax(0, 1fr); gap: 12px 16px; }
    .ligne-vignette { width: 84px; }
    .ligne-actions { grid-column: 1 / -1; flex-direction: row; flex-wrap: wrap; align-items: center; justify-content: space-between; }
    .ligne-prix { order: 2; }
    .ligne-actions .lien-action { order: 3; flex-basis: 100%; }
    .ligne-texte { font-size: 1.3rem; }
  }
</style>
