---
// Marque visible d'une information que l'atelier doit fournir.
// Règle du projet : rien n'est inventé ; ce qui manque s'affiche ainsi, et le questionnaire
// de l'admin (chantier C6) remplit le champ correspondant.
interface Props { quoi: string }
const { quoi } = Astro.props;
---
<span class="a-completer" data-a-completer={quoi}>[À COMPLÉTER : {quoi}]</span>

<style>
  .a-completer {
    font-family: var(--f-machine);
    font-size: 0.92em;
    /* Pas la couleur gravure : elle est réservée à l'achat. Visible sans gêner la lecture. */
    color: var(--texte-doux);
    border-bottom: 1px dashed currentColor;
    overflow-wrap: anywhere;
  }
</style>
