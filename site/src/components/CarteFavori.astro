---
// Variante de CartePiece avec le bouton cœur posé sur la photo. Le bouton reste hors du lien
// (pas de bouton dans un lien). S'utilise dans une grille à filets comme CartePiece ;
// GrillePieces la pose sur toutes les grilles, pour garder une pièce sans ouvrir sa fiche.
// `action` ajoute sous la carte un lien direct vers le configurateur de la fiche (page Favoris).
import CartePiece from "./CartePiece.astro";
import BoutonFavori from "./BoutonFavori.astro";
import type { Produit } from "../lib/donnees";

interface Props { produit: Produit & { numero: number }; prioritaire?: boolean; action?: boolean; [attr: string]: unknown }
const { produit, prioritaire = false, action = false, ...reste } = Astro.props;
const personnalisable = produit.options?.texte !== false;
---
<div class="carte-favori" {...reste}>
  <CartePiece produit={produit} prioritaire={prioritaire} />
  <BoutonFavori id={produit.id} nom={produit.nom} class="carte-favori-coeur" />
  {action && (
    <a class="carte-action machine" href={`/produit/${produit.id}/#personnaliser`} aria-label={`${personnalisable ? "Personnaliser" : "Commander"} : ${produit.nom}`}>
      {personnalisable ? "Personnaliser" : "Commander"}
    </a>
  )}
</div>

<style>
  .carte-favori { position: relative; display: flex; flex-direction: column; margin: 0 1px 1px 0; min-width: 0; background: var(--bouleau); }
  .carte-favori > :global(.carte-piece) { margin: 0; flex: 1; }
  .carte-favori > :global(.carte-favori-coeur) { position: absolute; top: 8px; right: 8px; }
  .carte-action { display: flex; align-items: center; justify-content: center; min-height: var(--cible); border-top: var(--filet); font-weight: 700; text-decoration: none; }
  .carte-action:hover { background: var(--brule); color: var(--bouleau); }
</style>
