---
// Boutique : toutes les pièces visibles, dans l'ordre du catalogue.
import Base from "../layouts/Base.astro";
import PageBoutique from "../components/PageBoutique.astro";
import { produits, categories } from "../lib/donnees";

const description = `Les ${produits.length} pièces de l'atelier, avec leur prix : ${categories.map((c) => c.nom.toLowerCase()).join(", ")}.`;
---
<Base titre="Boutique" description={description}>
  <PageBoutique titre="Boutique" pieces={produits} />
</Base>
