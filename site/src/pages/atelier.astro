---
// L'atelier : Christophe et Laetitia, la boutique de la rue Salengro, techniques et matières.
// Textes tirés de textes.aPropos et des catégories. Le deuxième paragraphe de aPropos est repris
// en liste de définitions (techniques, matières, clients) plutôt que tel quel.
// Pas de citation signée tant que l'atelier n'en a pas écrit une ; pas de img/boutique-auchel.jpg (c'est un flyer).
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import ACompleter from "../components/ACompleter.astro";
import TeteSection from "../components/TeteSection.astro";
import Bouton from "../components/Bouton.astro";
import EtatOuverture from "../components/EtatOuverture.astro";
import { donnees, categories, site } from "../lib/donnees";
import { adresseEnLignes } from "../lib/format";
import { image } from "../lib/images";

const { equipe, aPropos } = donnees.textes;
const [presentation, , salons] = aPropos;
const boutique = image("img/boutique-interieur.jpg");
const stand = image("img/salon-stand.jpg");
const { rue, ville } = adresseEnLignes(site.adresse);

const savoirFaire: [string, string][] = [
  ["Techniques", "Gravure laser, sérigraphie et impression, bijoux gravés"],
  ["Matières", "Bois, verre et ardoise pour la gravure ; mugs, verres et textiles pour l'impression"],
  ["Pour qui", "Particuliers, commerçants, associations et entreprises"],
  ["Quantités", "Une pièce seule ou une série"],
  ["Avant fabrication", phraseMaquette.replace(/\.$/, "")],
];
const PHOTOS = ["photo de l'atelier", "photo de la machine laser", "photo de Christophe et Laetitia"];
const largeurs = (w: number) => [480, 720, 960, 1200].filter((x) => x <= w);
import { phraseMaquette } from "../lib/promesses";
---
<Base titre="L'atelier" description={`${equipe}, gravure laser, sérigraphie et bijoux gravés dans leur boutique de la rue Salengro, à Auchel.`} image="img/boutique-interieur.jpg">
  <section class="bande">
    <div class="conteneur ouverture">
      <div class="pile ouverture-texte" style="--pile: 24px">
        <p class="etiquette">{equipe} · {ville}</p>
        <h1>L'atelier-boutique de la rue Salengro</h1>
        {presentation && <p class="chapeau">{presentation}</p>}
        <blockquote class="mot" aria-label={`Le mot de ${equipe}`}>
          <p><ACompleter quoi="mot de Christophe et Laetitia" /></p>
          <footer class="etiquette">{equipe}</footer>
        </blockquote>
      </div>
      <figure class="photo">
        {boutique && (
          <Image src={boutique} alt="L'intérieur de la boutique Mon Truc en Bois, avec ses étagères de pièces gravées" widths={largeurs(boutique.width)} sizes="(max-width: 900px) 100vw, 560px" format="webp" quality={78} loading="eager" fetchpriority="high" />
        )}
        <figcaption class="etiquette">La boutique, {rue} à Auchel.</figcaption>
      </figure>
    </div>
  </section>

  <section class="bande" aria-labelledby="titre-savoir">
    <div class="conteneur">
      <TeteSection id="titre-savoir" titre="Ce que nous fabriquons" lien={{ href: "/boutique/", libelle: "Voir les pièces de la boutique" }} />
      <dl class="definitions">
        {savoirFaire.map(([terme, definition]) => (
          <div><dt class="etiquette">{terme}</dt><dd>{definition}</dd></div>
        ))}
        <div><dt class="etiquette">Machine</dt><dd><ACompleter quoi="machine laser utilisée (type, surface de travail)" /></dd></div>
      </dl>

      <dl class="familles">
        {categories.map((c) => (
          <div><dt>{c.nom}</dt><dd>{c.description}</dd></div>
        ))}
      </dl>
    </div>
  </section>

  <section class="bande" aria-labelledby="titre-photos">
    <div class="conteneur">
      <TeteSection
        id="titre-photos"
        titre="À l'atelier et sur les salons"
        texte={salons ? salons.replace(/\s*!$/, ".") : undefined}
        lien={site.facebook ? { href: site.facebook, libelle: "Notre page Facebook" } : undefined}
      />
      <div class="photos">
        <figure class="photo">
          {stand && (
            <Image src={stand} alt="Le stand Mon Truc en Bois en salon, avec planches, plaques et porte-clés gravés" widths={largeurs(stand.width)} sizes="(max-width: 640px) 50vw, 320px" format="webp" quality={78} />
          )}
          <figcaption class="etiquette">Le stand, aux salons et marchés de la région.</figcaption>
        </figure>
        {PHOTOS.map((p) => (
          <figure class="photo-a-venir">
            <div class="cadre"><ACompleter quoi={p} /></div>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section class="bande bande-kraft" aria-labelledby="titre-visite">
    <div class="conteneur visite">
      <div class="pile" style="--pile: 8px">
        <h2 id="titre-visite">Venir à la boutique</h2>
        <p>{rue}, {ville}. Horaires, téléphone et email sur la page contact.</p>
        <EtatOuverture class="machine visite-etat" />
      </div>
      <div class="rangee">
        <Bouton href="/contact/#devis">Demander un devis</Bouton>
        <Bouton href="/contact/" genre="contour">Horaires et accès</Bouton>
      </div>
    </div>
  </section>
</Base>

<style>
  .ouverture { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 40px 64px; align-items: end; }
  .ouverture h1 { max-width: 12ch; }

  .photo { margin: 0; display: flex; flex-direction: column; gap: 10px; min-width: 0; }
  .photo :global(img) { width: 100%; height: auto; aspect-ratio: 4 / 3; object-fit: cover; border: var(--filet); background: var(--kraft); }
  .ouverture .photo :global(img) { aspect-ratio: 4 / 5; }

  .definitions { margin: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr)); column-gap: 32px; border-top: var(--filet-fort); }
  .definitions div, .familles div { padding: 14px 0; border-bottom: var(--filet); min-width: 0; }
  .definitions dd, .familles dd { margin: 4px 0 0; }

  .familles { margin: 40px 0 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(280px, 100%), 1fr)); column-gap: 32px; }
  .familles dt { font-family: var(--f-titre); font-weight: 800; font-size: 1.5rem; text-transform: uppercase; line-height: 1.05; }

  /* Le mot de l'équipe, sous la présentation (il reste à écrire). */
  .mot { margin: 4px 0 0; max-width: 40em; border-top: var(--filet-fort); padding-top: 14px; display: flex; flex-direction: column; gap: 10px; font-size: 1.2rem; font-style: italic; }
  .mot footer { font-style: normal; }

  /* Photo du stand et photos à venir, sur une rangée (deux colonnes au téléphone). */
  .photos { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 20px; align-items: start; }
  .photo-a-venir { margin: 0; }
  .cadre { aspect-ratio: 4 / 3; border: 1px dashed var(--brule); background: var(--papier); display: flex; align-items: center; justify-content: center; padding: 14px; text-align: center; font-size: var(--t-etiquette); }

  .visite { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 20px 40px; }
  .visite h2 { font-size: var(--t-sous-titre); }
  .visite :global(.visite-etat) { display: block; min-height: 1.55em; }

  @media (max-width: 1000px) {
    .photos { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
  }
  @media (max-width: 900px) {
    .ouverture { grid-template-columns: minmax(0, 1fr); }
  }
</style>
